# =============================================================================
# SUPABASE CONFIGURATION
# =============================================================================
# Your Supabase Project URL (Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (recommended for full table access bypassing RLS)
# Or ANON key if you want Claude to respect RLS
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# SUPABASE_KEY=your_supabase_anon_key_here

# =============================================================================
# SERVER & TRANSPORT CONFIGURATION
# =============================================================================
PORT=3000
HOST=0.0.0.0

# Optional: Protect endpoints with an authentication token (Bearer or ?apiKey=...)
# Highly recommended when exposing the server publicly on Railway, Render, Fly.io, etc.
# AUTH_TOKEN=your-secret-token

# =============================================================================
# TABLE MAPPINGS (OPTIONAL)
# The server will automatically detect english or portuguese names (e.g. contatos, conversas)
# but you can explicitly specify your table names here if needed:
# =============================================================================
# TABLE_CONTACTS=contacts
# TABLE_CONVERSATIONS=conversations
# TABLE_MESSAGES=messages
