{
  "name": "supabase-mcp",
  "version": "1.0.0",
  "description": "Streamable HTTP and SSE MCP Server for Supabase (compatible with Claude, Cursor, and MCP clients)",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "supabase-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "start:stdio": "node dist/index.js --stdio"
  },
  "keywords": [
    "mcp",
    "supabase",
    "modelcontextprotocol",
    "claude",
    "streamable-http",
    "sse"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
